@using HomeCompanion.Values;

@implements IDisposable

@if (ParametersContainer is null)
{
    <span class="text-muted">No parameters</span>
}
else
{
    <div class="d-flex flex-column gap-2">
        @foreach (var parameter in _parameters)
        {
            <Parameter Value="@parameter" />
        }
    </div>
}

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="text-danger small mt-2">@_errorMessage</div>
}

@code
{
    [Microsoft.AspNetCore.Components.Parameter]
    public IParametersContainer? ParametersContainer { get; set; }

    private List<IParameterCallbackRegistration> _changedSubscriptions = [];
    private List<IParameter> _parameters = [];
    private string? _errorMessage;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        ResetSubscriptions();
        _errorMessage = null;

        if (ParametersContainer is null)
        {
            _parameters = [];
            return;
        }

        try
        {
            _parameters = ParametersContainer.Parameters.ToList();
            foreach (var parameter in _parameters)
            {
                var subscription = parameter.RegisterChangedCallback(OnParameterChanged);
                _changedSubscriptions.Add(subscription);
            }
        }
        catch (Exception ex)
        {
            _parameters = [];
            _errorMessage = $"Failed to load parameters for '{ParametersContainer.Name}': {ex.Message}";
        }
    }

    private void OnParameterChanged(IParameter parameter)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ResetSubscriptions();
    }

    private void ResetSubscriptions()
    {
        foreach (var subscription in _changedSubscriptions)
        {
            subscription.Dispose();
        }

        _changedSubscriptions.Clear();
    }
}