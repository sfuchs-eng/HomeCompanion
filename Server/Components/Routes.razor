@using HomeCompanion.Extensions
@inject IHomeCompanionPageRegistry PageRegistry

<Router AppAssembly="typeof(App).Assembly" AdditionalAssemblies="PageRegistry.AdditionalAssemblies" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
