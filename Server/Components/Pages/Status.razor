@page "/"
@page "/status"
@rendermode InteractiveServer

@using HomeCompanion
@using HomeCompanion.Core
@using HomeCompanion.Diagnostics;
@using HomeCompanion.Extensions
@using HomeCompanion.Logics
@using HomeCompanion.Values
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.Extensions.DependencyInjection

@inject IEnumerable<IConnectivityProvider> ConnectivityProviders
@inject IEnumerable<ILogic> Logics
@inject IEnumerable<IValuesContainer> ValuesContainers
@inject IServiceProvider ServiceProvider

<PageTitle>System Status</PageTitle>

<h1>System Status</h1>

<div class="mb-4">
    <h4 class="mb-3">Connectivity Providers</h4>
    @if (!ConnectivityProviders.Any())
    {
        <p class="text-muted">No connectivity providers registered.</p>
    }
    else
    {
        <p class="text-muted">Only enabled connectivity providers are shown. Disabled ones aren't loaded at all.</p>
        <table class="table table-sm table-bordered">
            <thead class="table-light">
                <tr>
                    <th>Type</th>
                    <th>Connected</th>
                    <th>Initialization Finished</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var provider in ConnectivityProviders)
                {
                    <tr>
                        <td><code>@provider.GetType().Name</code></td>
                        <td>
                            @if (provider.IsConnected)
                            {
                                <span class="badge text-bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge text-bg-danger">No</span>
                            }
                        </td>
                        <td>
                            @if (provider.IsInitializationFinished)
                            {
                                <span class="badge text-bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge text-bg-warning text-dark">No</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div class="mb-4">
    <h4 class="mb-3">Logic Modules</h4>
    @if (!GetAllLogicReferences().Any())
    {
        <p class="text-muted">No logic modules registered.</p>
    }
    else
    {
        <table class="table table-sm table-bordered">
            <thead class="table-light">
                <tr>
                    <th>Type</th>
                    <th>Activated</th>
                    <th>Enabled</th>
                    <th>Activation exception</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var logicRef in GetAllLogicReferences())
                {
                    <tr>
                        <td><code>@logicRef.TypeName</code></td>
                        <td>
                            @if (logicRef.IsActivated)
                            {
                                <span class="badge text-bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">No</span>
                            }
                        </td>
                        <td>
                            @if (logicRef.IsEnabled)
                            {
                                <span class="badge text-bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">No</span>
                            }
                        </td>
                        <td>
                            @if (logicRef.ActivationException is not null)
                            {
                                <span class="text-danger">@logicRef.ActivationException.Message</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div class="mb-4">
    <h4 class="mb-3">Values Containers</h4>
    @if (!ValuesContainers.Any())
    {
        <p class="text-muted">No values containers registered.</p>
    }
    else
    {
        <table class="table table-sm table-bordered">
            <thead class="table-light">
                <tr>
                    <th>Type</th>
                    <th>Value Count</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var container in ValuesContainers.Distinct())
                {
                    var values = container.GetValues().ToList();
                    <tr>
                        <td><code>@container.GetType().Name</code></td>
                        <td>@values.Count</td>
                        <td>
                            <NavLink class="btn btn-sm btn-outline-primary" href="values">
                                Open Values Page
                            </NavLink>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (ServiceProvider.GetService<IServiceMonitor>() is IServiceMonitor serviceMonitor)
{
    <div class="mb-4">
        <h4 class="mb-3">Monitored Services</h4>
        @if (!serviceMonitor.Services.Any())
        {
            <p class="text-muted">No services monitored.</p>
        }
        else
        {
            <p class="text-muted">Changes require a page refresh</p>
            <table class="table table-sm table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>Service Name</th>
                        <th>Status</th>
                        <th>Status time stamp</th>
                        <th>Last up time</th>
                        <th>Exceptions, first</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var serviceStatus in serviceMonitor
                        .Services
                        .Select(s => s.GetServiceStatusInfoAsync().GetAwaiter().GetResult())
                        .OrderBy(s => s.ServiceName))
                    {
                        <tr>
                            <td>@serviceStatus.ServiceName</td>
                            <td>@RenderServiceStatus(serviceStatus.Status)</td>
                            <td>@serviceStatus.TimeStamp.ToString("o")</td>
                            <td>@(serviceStatus.LastUpTime?.ToString("o") ?? "N/A")</td>
                            <td>@(serviceStatus.Exceptions?.Length > 0 ? ($"{serviceStatus.Exceptions?.Length}, {serviceStatus.Exceptions?.FirstOrDefault()?.Message}") : "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

<footer class="footer mt-auto py-3 bg-light border-top">
    <div class="container text-center text-muted">
        <small><span class="font-monospace">@BuildVersionInfo.GetBuildVersion()</span></small>
    </div>
</footer>

@code {
    private MarkupString RenderValueStatus(ValueStatus status)
    {
        if (status == ValueStatus.Default)
            return new MarkupString("<span class=\"badge text-bg-secondary\">Default</span>");

        var badges = new System.Text.StringBuilder();
        if (status.HasFlag(ValueStatus.Loaded) && !(status.HasFlag(ValueStatus.Initialized) || status.HasFlag(ValueStatus.Live)))
            badges.Append("<span class=\"badge text-bg-light text-dark me-1\">Loaded</span>");
        if (status.HasFlag(ValueStatus.Initialized) && !status.HasFlag(ValueStatus.Live))
            badges.Append("<span class=\"badge text-bg-primary me-1\">Initialized</span>");
        if (status.HasFlag(ValueStatus.Live))
            badges.Append("<span class=\"badge text-bg-success text-light me-1\">Live</span>");
        if (status.HasFlag(ValueStatus.Used))
            badges.Append("<span class=\"badge text-bg-light text-dark border me-1\">Used</span>");
        if (status.HasFlag(ValueStatus.OutOfRange))
            badges.Append("<span class=\"badge text-bg-warning text-dark me-1\">OutOfRange</span>");
        if (status.HasFlag(ValueStatus.Error))
            badges.Append("<span class=\"badge text-bg-danger me-1\">Error</span>");

        return new MarkupString(badges.ToString());
    }

    private MarkupString RenderServiceStatus(ServiceStatus status)
    {
        return status switch
        {
            ServiceStatus.Up => new MarkupString("<span class=\"badge text-bg-success\">Running</span>"),
            ServiceStatus.Down => new MarkupString("<span class=\"badge text-bg-danger\">Error</span>"),
            ServiceStatus.Undefined => new MarkupString("<span class=\"badge text-bg-secondary\">Undefined</span>"),
            ServiceStatus.Deviation => new MarkupString("<span class=\"badge text-bg-warning text-dark\">Deviation</span>"),
            ServiceStatus.Disabled => new MarkupString("<span class=\"badge text-bg-secondary\">Disabled</span>"),
            _ => new MarkupString("<span class=\"badge text-bg-secondary\">Unknown</span>")
        };
    }

    private record LogicReference(string TypeName, bool IsLoaded, bool IsActivated, bool IsEnabled, Exception? ActivationException);

    private IEnumerable<LogicReference> GetAllLogicReferences()
    {
        return Logics.Select(l => new LogicReference(
            TypeName: l.GetType().FullName ?? l.GetType().Name,
            IsLoaded: true,
            IsActivated: l.IsActivated,
            IsEnabled: l.IsEnabled,
            ActivationException: l.ActivationException
        )).Concat(GetNonLoadedLogicReferences());
    }

    private IEnumerable<LogicReference> GetNonLoadedLogicReferences()
    {
        // get all ILogic from loaded assemblies
        var loadedLogicTypes = AppDomain.CurrentDomain.GetAssemblies()
            .SelectMany(a => a.GetTypes())
            .Where(t => typeof(ILogic).IsAssignableFrom(t) && !t.IsAbstract && !t.IsInterface);
        
        // remove the ones that are already loaded
        var loadedLogicHashSet = new HashSet<Type>(Logics.Select(l => l.GetType()));
        var nonLoadedLogicTypes = loadedLogicTypes
            .Where(t => !loadedLogicHashSet.Contains(t));

        return nonLoadedLogicTypes.Select(t => new LogicReference(
            TypeName: t.FullName ?? t.Name,
            IsLoaded: false,
            IsActivated: false,
            IsEnabled: false,
            ActivationException: new Exception("ILogic not not instantiated / not found in service container.")
        ));
    }
}
