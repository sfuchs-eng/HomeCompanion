@page "/diagnostics"
@rendermode InteractiveServer

@using HomeCompanion.Diagnostics
@using HomeCompanion.Server.Components.Widgets
@using Radzen

@inject IDiagnosticBrowser Browser

<div class="diagnostics-dashboard">
    <h1>System Diagnostics</h1>

    <!-- Select a diagnosable component -->
    <RadzenDropDown Data="@DiagnosableNames"
                    @bind-Value="SelectedDiagnosableName"
                    Placeholder="Select a diagnostic source"
                    AllowClear="true"
                    Change="OnDiagnosableSelected"
                    Style="width: 100%; margin-bottom: 1rem;" />

    @if (isLoading)
    {
        <p>Fetching diagnosis...</p>
    }
    else if (rootNode != null)
    {
        <div class="mt-4">
            <DiagnosticNode Node="rootNode" IsExpanded="true" />
        </div>
    }
    else
    {
        <p class="mt-4">Select a component to view its diagnostics.</p>
    }
</div>

@code {
    private IDiagnosticResultNode? rootNode;
    private bool isLoading;
    private string? SelectedDiagnosableName { get; set; }
    private IEnumerable<string> DiagnosableNames => Browser.GetDiagnosables().Select(d => d.Name);

    private async Task OnDiagnosableSelected(object? value)
    {
        var selectedName = value?.ToString();
        if (string.IsNullOrWhiteSpace(selectedName)) return;

        isLoading = true;
        
        try
        {
            // Use the Browser to fetch the root node by name
            rootNode = await Browser.GetDiagnosisAsync(selectedName, CancellationToken.None);
        }
        finally
        {
            isLoading = false;
        }
    }
}